---
import { getCollection } from 'astro:content'
import profile from '../../data/profile.json'
import BlogLayout from '../../layouts/BlogLayout.astro'

const posts = await getCollection('blog')
const sortedPosts = posts.sort((left, right) =>
  right.data.date === left.data.date
    ? left.id.localeCompare(right.id)
    : right.data.date.localeCompare(left.data.date),
)
---

<BlogLayout
  title="Blog | Pamela Chia"
  description={profile.blogIntro}
  canonicalUrl="https://pamelachia.com/blog/"
>
  <section class="blog-index" aria-labelledby="page-title">
    <h1 id="page-title">Blog</h1>
    <p class="lede">{profile.blogIntro}</p>
    {
      sortedPosts.length > 0 ? (
        <ol class="post-list">
          {sortedPosts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>
                <span>{post.data.title}</span>
                <time datetime={post.data.date}>{post.data.date}</time>
              </a>
              <p>{post.data.description}</p>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty-state">Writing will appear here.</p>
      )
    }
  </section>
</BlogLayout>

<style>
  .blog-index { width: min(100% - 3rem, 70rem); min-height: calc(100svh - 10rem); margin: 0 auto; padding: 8rem 0; }
  h1 { margin: 0 0 5rem; font-size: clamp(3.5rem, 10vw, 8rem); font-weight: 400; letter-spacing: -.07em; line-height: .88; }
  .lede { max-width: 42rem; margin: -3rem 0 4rem; font-size: clamp(1.35rem, 3vw, 2rem); line-height: 1.3; }
  .empty-state { color: #c5beb5; }
  .post-list { margin: 0; padding: 0; list-style: none; }
  .post-list li { padding: 2rem 0; border-top: 1px solid #5d5751; }
  .post-list a { display: flex; justify-content: space-between; gap: 2rem; font-size: clamp(1.35rem, 3vw, 2rem); text-decoration-thickness: 1px; }
  .post-list time { flex: none; color: #c5beb5; font-family: Arial, sans-serif; font-size: .72rem; letter-spacing: .08em; }
  .post-list p { max-width: 42rem; margin: .75rem 0 0; color: #c5beb5; }
  @media (max-width: 700px) { .blog-index { width: min(100% - 2rem, 70rem); padding: 5rem 0; } h1 { margin-bottom: 3.5rem; } .lede { margin: -1.5rem 0 3rem; } }
  @media (max-width: 430px) { .post-list a { align-items: flex-start; flex-direction: column; gap: .4rem; } }
</style>
